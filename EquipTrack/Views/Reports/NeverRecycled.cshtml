@model IEnumerable<EquipTrack.Models.Asset>

@{
    ViewData["Title"] = "Assets Never Recycled";
}

<h1>Assets Never Recycled</h1>
<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Serial Number</th>
        <th>Category</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.SerialNumber</td>
            <td>@item.Category?.Name</td>
            <td>@item.Status</td>
        </tr>
    }
    </tbody>
</table>