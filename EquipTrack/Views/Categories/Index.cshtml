@model IEnumerable<EquipTrack.Models.Category>
@{
    ViewData["Title"] = "Categories";
    ViewData["Heading"] = "Categories";
}

@section Sidebar {
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Quick Stats</h5>
            <p class="card-text">Total categories: @ViewBag.CategoryCount</p>
        </div>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Category</a>
</p>
<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>