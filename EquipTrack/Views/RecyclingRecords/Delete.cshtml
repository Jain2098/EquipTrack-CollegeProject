@model EquipTrack.Models.RecyclingRecord

@{
    ViewData["Title"] = "Delete";
    ViewData["Heading"] = "Delete Recycling Record";
}

<p class="text-danger">Are you sure you want to delete this recycling record?</p>
<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Asset)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Asset.Name)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DisposedOn)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DisposedOn)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.WipeMethod)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.WipeMethod)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>