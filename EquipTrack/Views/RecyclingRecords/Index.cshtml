@model IEnumerable<EquipTrack.Models.RecyclingRecord>

@{
    ViewData["Title"] = "Recycling Records";
    ViewData["Heading"] = "Recycling Records";
}

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Recycling Record</a>
</p>
<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Asset</th>
        <th>Disposed On</th>
        <th>Wipe Method</th>
        <th>Disposal Method</th>
        <th>Notes</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Asset?.Name</td>
            <td>@item.DisposedOn.ToString("MMM d, yyyy")</td>
            <td>@item.WipeMethod</td>
            <td>@item.DisposalMethod</td>
            <td>@item.Notes</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>