@model IEnumerable<EquipTrack.Models.Asset>

@{
    ViewData["Title"] = "Assets";
    ViewData["Heading"] = "Assets";
}

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New Asset</a>
</p>
<table class="table table-striped table-hover">
    <thead>
    <tr>
        <th>Name</th>
        <th>Serial Number</th>
        <th>Category</th>
        <th>Status</th>
        <th>Purchase Price</th>
        <th>Warranty Expires</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.SerialNumber</td>
            <td>@item.Category?.Name</td>
            <td><span class="badge @item.Status.ToBadgeClass()">@item.Status</span></td>
            <td>@item.PurchasePrice.ToString("C")</td>
            <td>@item.WarrantyExpirationDate.ToString("MMM d, yyyy")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>