@model EquipTrack.Models.Asset

@{
    ViewData["Title"] = "Delete";
    ViewData["Heading"] = "Delete Asset";
}

<p class="text-danger">Are you sure you want to delete this asset?</p>
<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SerialNumber)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Category)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Category.Name)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9"><span class="badge @Model.Status.ToBadgeClass()">@Model.Status</span></dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>