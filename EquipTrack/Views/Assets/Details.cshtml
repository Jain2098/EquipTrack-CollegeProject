@model EquipTrack.Models.Asset

@{
    ViewData["Title"] = "Details";
    ViewData["Heading"] = "Asset Details";
}

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SerialNumber)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Model)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Model)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Manufacturer)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Manufacturer)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PurchaseDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PurchaseDate)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PurchasePrice)</dt>
            <dd class="col-sm-9">@Model.PurchasePrice.ToString("C")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.WarrantyExpirationDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.WarrantyExpirationDate)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-9"><span class="badge @Model.Status.ToBadgeClass()">@Model.Status</span></dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CustomFieldsJson)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomFieldsJson)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Category)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Category.Name)</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary btn-sm">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
</div>